---
import ErrorScreen from '../components/ErrorScreen.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
const dev = import.meta.env.DEV;
---
<SiteLayout title="Error Screen Preview | Confluence" description="Development-only preview of branded error states.">
{dev ? <div><nav style="position:fixed;z-index:20;top:0;right:0;padding:12px;background:#101a2b"><a href="/error-preview?state=404">404</a> · <a href="/error-preview?state=500">500</a> · <a href="/error-preview?state=network">Network</a> · <a href="/error-preview?state=timeout">Timeout</a> · <a href="/error-preview?state=unauthorized">401</a> · <a href="/error-preview?state=forbidden">403</a> · <a href="/error-preview?state=form">Form</a> · <a href="/error-preview?state=empty">Empty</a></nav><ErrorScreen code="DEV PREVIEW" title="Error screen preview" message="Use the state links to inspect each visual treatment. This route is only enabled by the development server." primaryAction={{label:'Return home',href:'/'}} variant="storm" /><script>const states={"404":["404 · PAGE NOT FOUND","Looks like we’ve lost our way.","This page has drifted beyond the horizon. It may have moved or no longer exists.","Return home","storm"],"500":["500 · SYSTEM ERROR","Something went wrong.","An unexpected error interrupted your journey. Please try again in a moment.","Try again","storm"],network:["NETWORK ERROR","We’ve lost the signal.","Your connection seems to have disappeared into the storm. Check your internet and try again.","Retry connection","storm"],timeout:["REQUEST TIMEOUT","This is taking longer than expected.","The request hasn’t completed yet. Please try again.","Try again","storm"],unauthorized:["401 · SIGN IN REQUIRED","You need to sign in.","This area is reserved for authorized participants or organizers.","Sign in","calm"],forbidden:["403 · ACCESS RESTRICTED","This path is closed.","You don’t have permission to access this area.","Return to dashboard","calm"],form:["SUBMISSION INTERRUPTED","Your message got caught in the storm.","We couldn’t submit your information. Your entered details should remain available so you can retry.","Return to form","storm"],empty:["","Nothing on the horizon. Yet.","There’s no content here just yet. The skies may clear as the event takes shape.","Explore themes","empty"]};const key=new URLSearchParams(location.search).get('state');if(states[key]){const s=states[key],r=document.querySelector('[data-error-screen]');r.dataset.variant=s[4];r.className='error-screen error-screen--'+s[4];const c=r.querySelector('.error-code');if(c)c.textContent=s[0];else if(s[0]){const n=document.createElement('p');n.className='error-code';n.textContent=s[0];r.querySelector('.error-content').prepend(n);}r.querySelector('.error-content h1').textContent=s[1];r.querySelector('.error-message').textContent=s[2];r.querySelector('.error-button--primary').textContent=s[3];}</script></div> : <ErrorScreen code="404" title="Looks like we’ve lost our way." message="This page has drifted beyond the horizon. It may have moved or no longer exists." primaryAction={{label:'Return home',href:'/'}} variant="storm" />}
</SiteLayout>
