---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { themeWorlds } from '../../data/worlds';
export function getStaticPaths(){ return themeWorlds.map(world=>({params:{slug:world.slug},props:{world}})); }
const { world } = Astro.props;
---
<SiteLayout title={`${world.title} | Confluence Theme World`} description={world.summary}>
<main class={`feature-page immersive-world world-${world.world}`} style={`--world-accent:${world.accent};--world-image:url('/assets/${world.image}')`} data-world="true"><section class="world-hero-art" aria-label={`${world.title} concept artwork`}><div class="world-hero-shade"></div><div class="world-hero-copy"><a class="back-link" href="/themes">← All theme worlds</a><p class="eyebrow">{world.eyebrow} · FICTIONAL CONCEPT</p><h1>{world.title}</h1><p>{world.summary}</p><p class="concept-note">Prototype concept only — not an official Confluence theme.</p></div></section><section class="problem-panel"><p class="eyebrow">THE PROBLEM SPACE</p><h2>{world.problem}</h2><div class="direction-list">{world.directions.map((d,i)=><div><span>0{i+1}</span><p>{d}</p></div>)}</div></section><section class="challenge-section"><p class="eyebrow">CHOOSE A CHALLENGE</p><h2>Questions worth building for.</h2><div class="challenge-layout"><div class="challenge-list" role="tablist" aria-label="Challenges">{world.challenges.map((c,i)=><button class="challenge-button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`challenge-${c.id}`} id={`tab-${c.id}`} data-challenge={c.id}><span>0{i+1}</span><strong>{c.title}</strong><span aria-hidden="true">↗</span></button>)}</div>{world.challenges.map((c,i)=><article class="challenge-detail" id={`challenge-${c.id}`} role="tabpanel" aria-labelledby={`tab-${c.id}`} hidden={i!==0}><h3>{c.title}</h3><p>{c.description}</p><div class="detail-columns"><div><h4>Constraints</h4><ul>{c.constraints.map(x=><li>{x}</li>)}</ul></div><div><h4>Expected outcomes</h4><ul>{c.outcomes.map(x=><li>{x}</li>)}</ul></div><div><h4>Judging lens</h4><ul>{c.judging.map(x=><li>{x}</li>)}</ul></div></div><p class="tech-line"><strong>Possible technologies</strong> · {c.technologies.join(' / ')}</p></article>)}</div></section><nav class="world-switch" aria-label="Other theme worlds"><a href="/themes">All themes</a>{themeWorlds.filter(w=>w.slug!==world.slug).map(w=><a href={`/themes/${w.slug}`} data-ripple-link>{w.title} ↗</a>)}</nav></main><script is:inline>document.querySelectorAll('[data-challenge]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-challenge]').forEach(b=>b.setAttribute('aria-selected',String(b===btn)));document.querySelectorAll('.challenge-detail').forEach(p=>p.hidden=p.id!==`challenge-${btn.dataset.challenge}`)}));</script>
</SiteLayout>
