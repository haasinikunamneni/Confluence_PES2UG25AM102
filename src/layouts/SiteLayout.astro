---
import EclipseLoader from "../components/EclipseLoader.astro";
const { title = "Confluence 2026 — IEEE CS PESU", description = "A national level hackathon by IEEE CS PESU." } = Astro.props;
const site = "https://your-domain.example"; // Replace when the production domain is confirmed.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#070A10" />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={`${site}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${site}/`} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/assets/fonts/bodoni-moda-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/environment.css" />
  <link rel="stylesheet" href="/css/sections.css" />
  <link rel="stylesheet" href="/css/immersive.css" />
</head>
<body>
  <EclipseLoader />
  <slot />
  <script src="/js/ripple.js" defer></script>
</body>
</html>
